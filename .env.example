# Copy to .env and set real values. .env is git-ignored.
BI_ADMIN_PASSWORD=change-me-admin
BI_OWNER_PASSWORD=change-me-owner
BI_ANALYST_PASSWORD=change-me-analyst
# DSNs must use the same passwords. Host 127.0.0.1: the database only listens on localhost.
ADMIN_DSN=postgresql://bi_admin:change-me-admin@127.0.0.1:5435/larkfield_bi
OWNER_DSN=postgresql://bi_owner:change-me-owner@127.0.0.1:5435/larkfield_bi
ANALYST_DSN=postgresql://analyst_ro:change-me-analyst@127.0.0.1:5435/larkfield_bi
LLM_PROVIDER=ollama
OLLAMA_MODEL=fusion27b:iq3
# ANTHROPIC_API_KEY=
